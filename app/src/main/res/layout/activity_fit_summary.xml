<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/fit_analysis_title"
            app:navigationIcon="@drawable/ic_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Grade Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/grade_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">

                    <!-- Grade emoji -->
                    <TextView
                        android:id="@+id/grade_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="48sp"
                        tools:text="✅" />

                    <!-- Grade text -->
                    <TextView
                        android:id="@+id/grade_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/recommendation_text_primary"
                        tools:text="Excellent Fit" />

                    <!-- Brief summary -->
                    <TextView
                        android:id="@+id/grade_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/recommendation_text_secondary"
                        android:textAlignment="center"
                        tools:text="Your bike fit looks great! No adjustments needed." />

                    <!-- Issue count -->
                    <TextView
                        android:id="@+id/issue_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/action_background"
                        android:textSize="12sp"
                        android:textColor="@color/purple_700"
                        android:visibility="gone"
                        tools:text="3 issues found • 1 high priority"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Metrics Table -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/metrics_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Metric Analysis"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:text="Metric"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                            
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Your Value"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                            
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ideal Range"
                            android:gravity="center"
                             android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDDDDD"
                        android:layout_marginVertical="8dp"/>

                    <!-- Max Extension Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:orientation="horizontal">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:text="Knee Extension"
                            android:textSize="14sp" />
                            
                        <TextView
                            android:id="@+id/metric_extension_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            tools:text="138°" />
                            
                        <TextView
                            android:id="@+id/metric_extension_range"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            tools:text="140°-150°" />
                    </LinearLayout>

                    <!-- Min Flexion Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:orientation="horizontal">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:text="Knee Flexion"
                            android:textSize="14sp" />
                            
                        <TextView
                            android:id="@+id/metric_flexion_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            tools:text="72°" />
                            
                        <TextView
                            android:id="@+id/metric_flexion_range"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            tools:text="70°-110°" />
                    </LinearLayout>

                    <!-- KOPS Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:orientation="horizontal">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:text="Knee fwd of Pedal"
                            android:textSize="14sp" />
                            
                        <TextView
                            android:id="@+id/metric_kops_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            tools:text="+12mm" />
                            
                        <TextView
                            android:id="@+id/metric_kops_range"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            tools:text="±10mm" />
                    </LinearLayout>

                     <!-- Reach Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:orientation="horizontal">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:text="Shoulder Angle"
                            android:textSize="14sp" />
                            
                        <TextView
                            android:id="@+id/metric_shoulder_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            tools:text="85°" />
                            
                        <TextView
                            android:id="@+id/metric_shoulder_range"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            tools:text="80°-100°" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recommendations section header -->
            <TextView
                android:id="@+id/recommendations_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/recommendations_header"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/recommendation_text_secondary"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Recommendations RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recommendations_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_fit_recommendation"
                tools:itemCount="3" />

            <!-- Empty state for no recommendations -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉"
                    android:textSize="64sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/no_recommendations"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/recommendation_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/optimal_fit_message"
                    android:textSize="14sp"
                    android:textColor="@color/recommendation_text_secondary"
                    android:textAlignment="center" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
