<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/fit_analysis_title"
            app:navigationIcon="@drawable/ic_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Grade Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/grade_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">

                    <!-- Grade emoji -->
                    <TextView
                        android:id="@+id/grade_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="48sp"
                        tools:text="✅" />

                    <!-- Grade text -->
                    <TextView
                        android:id="@+id/grade_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/recommendation_text_primary"
                        tools:text="Excellent Fit" />

                    <!-- Brief summary -->
                    <TextView
                        android:id="@+id/grade_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp"
                        android:textColor="@color/recommendation_text_secondary"
                        android:textAlignment="center"
                        tools:text="Your bike fit looks great! No adjustments needed." />

                    <!-- Issue count -->
                    <TextView
                        android:id="@+id/issue_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/action_background"
                        android:textSize="12sp"
                        android:textColor="@color/purple_700"
                        android:visibility="gone"
                        tools:text="3 issues found • 1 high priority"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Metrics Table -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/metrics_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Biomechanical Analysis"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/recommendation_text_primary"
                        android:letterSpacing="0.02" />
                    
                    <!-- Session Summary -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:background="@drawable/rounded_metrics_background">
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cycles"
                                android:textSize="11sp"
                                android:textColor="#AAAAAA" />
                            <TextView
                                android:id="@+id/cycle_count_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white"
                                android:layout_marginTop="4dp"
                                android:text="--" />
                        </LinearLayout>
                        
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#DDDDDD"
                            android:layout_marginHorizontal="8dp"/>
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cadence"
                                android:textSize="11sp"
                                android:textColor="#AAAAAA" />
                            <TextView
                                android:id="@+id/cadence_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white"
                                android:layout_marginTop="4dp"
                                android:text="--" />
                        </LinearLayout>
                        
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#DDDDDD"
                            android:layout_marginHorizontal="8dp"/>
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quality"
                                android:textSize="11sp"
                                android:textColor="#AAAAAA" />
                            <TextView
                                android:id="@+id/data_quality_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:layout_marginTop="4dp"
                                android:text="--" />
                        </LinearLayout>
                    </LinearLayout>
                    
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDDDDD"
                        android:layout_marginVertical="8dp"/>

                    <!-- A. Knee Flexion/Extension at BDC Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:orientation="vertical">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3"
                                android:text="Knee Angle (BDC)"
                                android:textSize="14sp" />
                                
                            <TextView
                                android:id="@+id/metric_knee_bdc_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                tools:text="148°" />
                                
                            <TextView
                                android:id="@+id/metric_knee_bdc_range"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                tools:text="145°-155°" />
                        </LinearLayout>
                        
                        <TextView
                            android:id="@+id/metric_knee_bdc_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:paddingStart="0dp"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:visibility="gone"
                            tools:text="Min: 145° | Max: 152° | SD: 3.2°"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- B. Hip Angle at TDC Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:orientation="vertical">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3"
                                android:text="Hip Angle (TDC)"
                                android:textSize="14sp" />
                                
                            <TextView
                                android:id="@+id/metric_hip_tdc_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                tools:text="55°" />
                                
                            <TextView
                                android:id="@+id/metric_hip_tdc_range"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                tools:text="40°-70°" />
                        </LinearLayout>
                        
                        <TextView
                            android:id="@+id/metric_hip_tdc_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:visibility="gone"
                            tools:text="Min: 48° | Max: 62° | SD: 2.8°"
                            tools:visibility="visible" />
                    </LinearLayout>

                     <!-- C. Torso Angle Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:orientation="vertical">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3"
                                android:text="Torso Angle"
                                android:textSize="14sp" />
                                
                            <TextView
                                android:id="@+id/metric_torso_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                tools:text="45°" />
                                
                            <TextView
                                android:id="@+id/metric_torso_range"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                tools:text="30°-60°" />
                        </LinearLayout>
                        
                        <TextView
                            android:id="@+id/metric_torso_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:visibility="gone"
                            tools:text="Min: 42° | Max: 48° | SD: 2.0°"
                            tools:visibility="visible" />
                    </LinearLayout>

                     <!-- D. Ankle Angle at BDC Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:orientation="vertical">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3"
                                android:text="Ankle Angle (BDC)"
                                android:textSize="14sp" />
                                
                            <TextView
                                android:id="@+id/metric_ankle_bdc_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                tools:text="95°" />
                                
                            <TextView
                                android:id="@+id/metric_ankle_bdc_range"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                tools:text="80°-110°" />
                        </LinearLayout>
                        
                        <TextView
                            android:id="@+id/metric_ankle_bdc_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:visibility="gone"
                            tools:text="Min: 88° | Max: 102° | SD: 4.2°"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- E. Knee Over Pedal (Normalized) Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:orientation="vertical">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3"
                                android:text="KOPS (Normalized)"
                                android:textSize="14sp" />
                                
                            <TextView
                                android:id="@+id/metric_kops_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                tools:text="0.05" />
                                
                            <TextView
                                android:id="@+id/metric_kops_range"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                tools:text="-0.1 - 0.1" />
                        </LinearLayout>
                        
                        <TextView
                            android:id="@+id/metric_kops_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:visibility="gone"
                            tools:text="Min: -0.05 | Max: 0.08 | SD: 0.02"
                            tools:visibility="visible" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Key Frames Section -->
            <TextView
                android:id="@+id/key_frames_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Critical Pedal Positions"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/recommendation_text_primary"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Key Frames Horizontal Scroll -->
            <HorizontalScrollView
                android:id="@+id/key_frames_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/key_frames_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:spacing="12dp" />

            </HorizontalScrollView>

            <!-- Recommendations section header -->
            <TextView
                android:id="@+id/recommendations_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/recommendations_header"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/recommendation_text_secondary"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Recommendations RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recommendations_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_fit_recommendation"
                tools:itemCount="3" />

            <!-- Empty state for no recommendations -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉"
                    android:textSize="64sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/no_recommendations"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/recommendation_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/optimal_fit_message"
                    android:textSize="14sp"
                    android:textColor="@color/recommendation_text_secondary"
                    android:textAlignment="center" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
