<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_metrics_background"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/metrics_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Live Metrics"
        android:textAllCaps="true"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cycle Count -->
    <TextView
        android:id="@+id/metric_cycles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 cycles"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="8 cycles" />

    <!-- Current Knee Angle -->
    <TextView
        android:id="@+id/label_knee_angle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Knee"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/metrics_title" />

    <TextView
        android:id="@+id/metric_knee_angle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="--"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/label_knee_angle"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="142°" />

    <!-- Hip Angle -->
    <TextView
        android:id="@+id/label_hip_angle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Hip"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label_knee_angle" />

    <TextView
        android:id="@+id/metric_hip_angle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="--"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/label_hip_angle"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="105°" />

    <!-- Torso Angle -->
    <TextView
        android:id="@+id/label_torso_angle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Torso"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label_hip_angle" />

    <TextView
        android:id="@+id/metric_torso_angle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="--"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/label_torso_angle"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="45°" />

    <!-- Separator -->
    <View
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#44FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label_torso_angle" />

    <!-- Max Extension (Last Cycle) -->
    <TextView
        android:id="@+id/label_max_extension"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Max Ext."
        android:textColor="#DDDDDD"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/separator" />

    <TextView
        android:id="@+id/metric_max_extension"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="--"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/label_max_extension"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="150°" />

    <!-- Min Flexion (Last Cycle) -->
    <TextView
        android:id="@+id/label_min_flexion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Min Flex."
        android:textColor="#DDDDDD"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label_max_extension" />

    <TextView
        android:id="@+id/metric_min_flexion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="--"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/label_min_flexion"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="70°" />

</androidx.constraintlayout.widget.ConstraintLayout>
