<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recommendation_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/recommendation_card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Severity indicator bar -->
        <View
            android:id="@+id/severity_indicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@color/severity_high"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:background="@color/severity_high" />

        <!-- Priority badge -->
        <TextView
            android:id="@+id/priority_badge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/priority_badge_background"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/severity_indicator"
            tools:text="1" />

        <!-- Category label -->
        <TextView
            android:id="@+id/category_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/recommendation_text_secondary"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            app:layout_constraintTop_toTopOf="@id/priority_badge"
            app:layout_constraintBottom_toBottomOf="@id/priority_badge"
            app:layout_constraintStart_toEndOf="@id/priority_badge"
            tools:text="SADDLE POSITION" />

        <!-- Severity icon -->
        <ImageView
            android:id="@+id/severity_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/severity_indicator"
            app:layout_constraintTop_toTopOf="@id/priority_badge"
            app:layout_constraintBottom_toBottomOf="@id/priority_badge"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@android:drawable/ic_dialog_alert" />

        <!-- Title -->
        <TextView
            android:id="@+id/recommendation_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/recommendation_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/priority_badge"
            app:layout_constraintStart_toEndOf="@id/severity_indicator"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Saddle height adjustment needed" />

        <!-- Description -->
        <TextView
            android:id="@+id/recommendation_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/recommendation_text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintTop_toBottomOf="@id/recommendation_title"
            app:layout_constraintStart_toEndOf="@id/severity_indicator"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Knee too extended at bottom of pedal stroke" />

        <!-- Action recommendation -->
        <TextView
            android:id="@+id/recommendation_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/action_background"
            android:textColor="@color/purple_700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/recommendation_description"
            app:layout_constraintStart_toEndOf="@id/severity_indicator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="➡ Lower saddle height" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
